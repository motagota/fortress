; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fortress City"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[global_scripts]

DeterministicRng="*res://scripts/simulation/deterministic_rng.gd"
GridWorld="*res://scripts/simulation/grid_world.gd"
SimCell="*res://scripts/simulation/cell.gd"
SimClock="*res://scripts/simulation/sim_clock.gd"
SimItem="*res://scripts/simulation/item.gd"
SimJob="*res://scripts/simulation/job.gd"
SimUnit="*res://scripts/simulation/unit.gd"
Simulation="*res://scripts/simulation/simulation.gd"
JobBoard="*res://scripts/simulation/job_board.gd"

[display]

display/window/size/viewport_width=1920
display/window/size/viewport_height=1080
display/window/size/mode=1
display/window/stretch/mode="canvas"
display/window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
